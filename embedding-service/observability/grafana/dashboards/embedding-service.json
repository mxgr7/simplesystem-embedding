{
  "title": "Embedding Service",
  "uid": "embedding-service",
  "schemaVersion": 38,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "timezone": "browser",
  "tags": ["embedding-service", "tei", "kvrocks"],
  "panels": [
    {
      "type": "row",
      "id": 100,
      "title": "Service health",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "id": 1,
      "title": "embedding-service",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 4, "w": 8, "x": 0, "y": 1},
      "targets": [{"expr": "up{job=\"embedding-service\"}", "refId": "A"}],
      "options": {"colorMode": "background", "textMode": "auto"},
      "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}]}, "overrides": []}
    },
    {
      "type": "stat",
      "id": 2,
      "title": "TEI",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 4, "w": 8, "x": 8, "y": 1},
      "targets": [{"expr": "up{job=\"tei\"}", "refId": "A"}],
      "options": {"colorMode": "background", "textMode": "auto"},
      "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}]}, "overrides": []}
    },
    {
      "type": "stat",
      "id": 3,
      "title": "KVRocks (via redis_exporter)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 4, "w": 8, "x": 16, "y": 1},
      "targets": [{"expr": "up{job=\"kvrocks\"}", "refId": "A"}],
      "options": {"colorMode": "background", "textMode": "auto"},
      "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}]}, "overrides": []}
    },

    {
      "type": "row",
      "id": 200,
      "title": "/embed traffic + latency",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5},
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 10,
      "title": "Request rate by status",
      "description": "Per-second request rate from the app-level counter, broken out by HTTP status.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6},
      "targets": [
        {"expr": "sum by (status) (rate(embedding_service_requests_total[1m]))", "legendFormat": "{{status}}", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"drawStyle": "line", "fillOpacity": 25, "stacking": {"mode": "normal"}}}, "overrides": []}
    },
    {
      "type": "timeseries",
      "id": 11,
      "title": "/embed latency (p50 / p95 / p99)",
      "description": "End-to-end latency on the /embed handler, derived from the FastAPI instrumentator's request-duration histogram.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket{handler=\"/embed\"}[5m])))", "legendFormat": "p50", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{handler=\"/embed\"}[5m])))", "legendFormat": "p95", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{handler=\"/embed\"}[5m])))", "legendFormat": "p99", "refId": "C"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
    },

    {
      "type": "row",
      "id": 300,
      "title": "Backpressure + batch shape",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 14},
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 20,
      "title": "Inflight requests",
      "description": "Concurrent /embed requests after the MGET gate. Approaches MAX_INFLIGHT (default 128) → 429 path activates.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 15},
      "targets": [{"expr": "embedding_service_inflight", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}
    },
    {
      "type": "heatmap",
      "id": 21,
      "title": "Batch size (inputs per request)",
      "description": "Distribution of N = len(inputs) per request. Buckets aligned with the TEI client batch (8) and the request cap (256).",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 15},
      "targets": [
        {"expr": "sum by (le) (rate(embedding_service_inputs_per_request_bucket[1m]))", "refId": "A", "format": "heatmap", "legendFormat": "{{le}}"}
      ],
      "options": {"calculate": false, "yAxis": {"unit": "short"}, "color": {"mode": "scheme", "scheme": "Spectral"}},
      "fieldConfig": {"defaults": {}, "overrides": []}
    },
    {
      "type": "timeseries",
      "id": 22,
      "title": "Cache hit ratio (EWMA)",
      "description": "Service-side EWMA of (hits / total) per request.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 23},
      "targets": [{"expr": "embedding_service_cache_hit_ratio", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []}
    },
    {
      "type": "heatmap",
      "id": 23,
      "title": "TEI semaphore wait (per chunk)",
      "description": "Time chunks spend waiting for a TEI concurrency slot. Rising = TEI saturating.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 23},
      "targets": [
        {"expr": "sum by (le) (rate(embedding_service_tei_semaphore_wait_seconds_bucket[1m]))", "refId": "A", "format": "heatmap", "legendFormat": "{{le}}"}
      ],
      "options": {"calculate": false, "yAxis": {"unit": "s"}, "color": {"mode": "scheme", "scheme": "Spectral"}},
      "fieldConfig": {"defaults": {}, "overrides": []}
    },

    {
      "type": "row",
      "id": 400,
      "title": "KVRocks (via redis_exporter)",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 31},
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 30,
      "title": "Command rate",
      "description": "Per-second Redis-protocol command rate against KVRocks. Aggregate only — KVRocks's cmdstat_* lines omit trailing fields (rejected_calls / failed_calls) that redis_exporter expects for per-command breakdown, so we use redis_commands_processed_total.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 32},
      "targets": [{"expr": "rate(redis_commands_processed_total[1m])", "legendFormat": "commands/s", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "cps"}, "overrides": []}
    },
    {
      "type": "timeseries",
      "id": 31,
      "title": "Process memory (RSS)",
      "description": "KVRocks process RSS — the in-memory working set serving SST reads. The 49 GB disk-backed cache is *not* this number; it's used_db_size in INFO keyspace.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 32},
      "targets": [{"expr": "redis_memory_used_rss_bytes", "legendFormat": "RSS", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []}
    },
    {
      "type": "timeseries",
      "id": 32,
      "title": "Keyspace size",
      "description": "Number of keys in db0 — total cached embeddings.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 40},
      "targets": [{"expr": "redis_db_keys", "legendFormat": "{{db}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}
    },
    {
      "type": "timeseries",
      "id": 33,
      "title": "TEI request count",
      "description": "Per-second TEI request rate from TEI's own /metrics. Should be << embedding-service request rate when cache hits dominate.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 40},
      "targets": [{"expr": "rate(te_request_count[1m])", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []}
    },

    {
      "type": "row",
      "id": 500,
      "title": "GPU (via DCGM exporter)",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 48},
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 40,
      "title": "GPU utilization",
      "description": "Percent of time the GPU was doing useful work during the last sample window.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 49},
      "targets": [{"expr": "DCGM_FI_DEV_GPU_UTIL", "legendFormat": "GPU {{gpu}} ({{modelName}})", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []}
    },
    {
      "type": "timeseries",
      "id": 41,
      "title": "GPU memory (stacked = total VRAM)",
      "description": "Stacked used + free = total VRAM. Stack height shows board capacity; the lower band is what's actively held by TEI + driver.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 49},
      "targets": [
        {"expr": "DCGM_FI_DEV_FB_USED * 1024 * 1024", "legendFormat": "used (GPU {{gpu}})", "refId": "A"},
        {"expr": "DCGM_FI_DEV_FB_FREE * 1024 * 1024", "legendFormat": "free (GPU {{gpu}})", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "bytes", "custom": {"fillOpacity": 25, "stacking": {"mode": "normal"}}}, "overrides": []}
    },
    {
      "type": "timeseries",
      "id": 42,
      "title": "GPU temperature",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 57},
      "targets": [{"expr": "DCGM_FI_DEV_GPU_TEMP", "legendFormat": "GPU {{gpu}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "celsius"}, "overrides": []}
    },
    {
      "type": "timeseries",
      "id": 43,
      "title": "GPU power",
      "description": "Instantaneous power draw. T4 TDP is 70 W.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 57},
      "targets": [{"expr": "DCGM_FI_DEV_POWER_USAGE", "legendFormat": "GPU {{gpu}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "watt"}, "overrides": []}
    },
    {
      "type": "timeseries",
      "id": 44,
      "title": "GPU SM clock",
      "description": "Streaming Multiprocessor clock frequency. Drops indicate thermal/power throttling.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 57},
      "targets": [{"expr": "DCGM_FI_DEV_SM_CLOCK", "legendFormat": "GPU {{gpu}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "rotmhz"}, "overrides": []}
    },

    {
      "type": "row",
      "id": 600,
      "title": "Host system (via node_exporter)",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 65},
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 50,
      "title": "CPU usage by mode",
      "description": "Fraction of total CPU time per mode (user, system, iowait, idle, etc.). Sum across all cores.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 66},
      "targets": [
        {"expr": "sum by (mode) (rate(node_cpu_seconds_total{mode!=\"idle\"}[1m])) / scalar(count(count by (cpu) (node_cpu_seconds_total)))", "legendFormat": "{{mode}}", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "custom": {"fillOpacity": 25, "stacking": {"mode": "normal"}}}, "overrides": []}
    },
    {
      "type": "timeseries",
      "id": 51,
      "title": "Memory (stacked = total RAM)",
      "description": "Stacked used + buffers + cached + free = MemTotal. Stack height shows host RAM; the bottom band is non-reclaimable in-use memory. Cached/buffers are reclaimable on pressure.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 66},
      "targets": [
        {"expr": "node_memory_MemTotal_bytes - node_memory_MemFree_bytes - node_memory_Buffers_bytes - node_memory_Cached_bytes", "legendFormat": "used", "refId": "A"},
        {"expr": "node_memory_Buffers_bytes", "legendFormat": "buffers", "refId": "B"},
        {"expr": "node_memory_Cached_bytes", "legendFormat": "cached", "refId": "C"},
        {"expr": "node_memory_MemFree_bytes", "legendFormat": "free", "refId": "D"}
      ],
      "fieldConfig": {"defaults": {"unit": "bytes", "custom": {"fillOpacity": 25, "stacking": {"mode": "normal"}}}, "overrides": []}
    },
    {
      "type": "timeseries",
      "id": 52,
      "title": "Disk I/O bytes/s (reads ↑, writes ↓)",
      "description": "Per-device read/write throughput on a mirrored axis: reads positive, writes negative. KVRocks compaction shows up on /mnt/nvme.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 74},
      "targets": [
        {"expr": "rate(node_disk_read_bytes_total[1m])", "legendFormat": "{{device}} read", "refId": "A"},
        {"expr": "-rate(node_disk_written_bytes_total[1m])", "legendFormat": "{{device}} write", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "Bps"}, "overrides": []}
    },
    {
      "type": "timeseries",
      "id": 53,
      "title": "Filesystem usage",
      "description": "Per-mount used / total bytes. KVRocks lives on /mnt/nvme (see fstype label).",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 74},
      "targets": [
        {"expr": "node_filesystem_size_bytes{fstype!~\"tmpfs|overlay|squashfs\"} - node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|squashfs\"}", "legendFormat": "{{mountpoint}} used", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []}
    },
    {
      "type": "timeseries",
      "id": 54,
      "title": "Network throughput (rx ↑, tx ↓)",
      "description": "Per-interface throughput on a mirrored axis: receive positive, transmit negative. Loopback / docker / veth interfaces excluded.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 82},
      "targets": [
        {"expr": "rate(node_network_receive_bytes_total{device!~\"lo|docker.*|veth.*|br-.*\"}[1m])", "legendFormat": "{{device}} rx", "refId": "A"},
        {"expr": "-rate(node_network_transmit_bytes_total{device!~\"lo|docker.*|veth.*|br-.*\"}[1m])", "legendFormat": "{{device}} tx", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "Bps"}, "overrides": []}
    },
    {
      "type": "timeseries",
      "id": 55,
      "title": "Load average",
      "description": "1 / 5 / 15-minute load averages. Plotted against the CPU-core count (a healthy box stays well below 1.0 × cores).",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 82},
      "targets": [
        {"expr": "node_load1", "legendFormat": "1m", "refId": "A"},
        {"expr": "node_load5", "legendFormat": "5m", "refId": "B"},
        {"expr": "node_load15", "legendFormat": "15m", "refId": "C"},
        {"expr": "count(count by (cpu) (node_cpu_seconds_total))", "legendFormat": "cores", "refId": "D"}
      ],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}
    }
  ]
}
