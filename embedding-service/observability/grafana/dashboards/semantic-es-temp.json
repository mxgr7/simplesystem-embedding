{
  "title": "Semantic ES (temp) \u2014 semantic-es-temp",
  "uid": "semantic-es-temp",
  "schemaVersion": 38,
  "version": 5,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "tags": [
    "elasticsearch",
    "semantic-es-temp",
    "knn"
  ],
  "panels": [
    {
      "type": "row",
      "id": 100,
      "title": "Cluster health",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "id": 1,
      "title": "Exporter up",
      "description": "Prometheus scrape target health for the elasticsearch_exporter.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "expr": "up{job=\"semantic_es_temp\"}",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "id": 2,
      "title": "Cluster status",
      "description": "elasticsearch_cluster_health_status \u2014 picks the color whose series == 1.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "targets": [
        {
          "expr": "label_replace(elasticsearch_cluster_health_status{cluster=\"semantic-es-temp\"} == 1, \"st\", \"$1\", \"color\", \"(.*)\")",
          "legendFormat": "{{color}}",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "colorMode": "background",
        "textMode": "name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "green": {
                  "color": "green",
                  "index": 0
                },
                "yellow": {
                  "color": "yellow",
                  "index": 1
                },
                "red": {
                  "color": "red",
                  "index": 2
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "id": 3,
      "title": "Nodes",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "expr": "elasticsearch_cluster_health_number_of_nodes{cluster=\"semantic-es-temp\"}",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "id": 4,
      "title": "Active shards",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "expr": "elasticsearch_cluster_health_active_shards{cluster=\"semantic-es-temp\"}",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "id": 5,
      "title": "Unassigned shards",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "expr": "elasticsearch_cluster_health_unassigned_shards{cluster=\"semantic-es-temp\"}",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "id": 6,
      "title": "Relocating / Initializing",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "targets": [
        {
          "expr": "elasticsearch_cluster_health_relocating_shards{cluster=\"semantic-es-temp\"}",
          "legendFormat": "relocating",
          "refId": "A"
        },
        {
          "expr": "elasticsearch_cluster_health_initializing_shards{cluster=\"semantic-es-temp\"}",
          "legendFormat": "initializing",
          "refId": "B"
        }
      ],
      "options": {
        "colorMode": "value",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "id": 200,
      "title": "JVM",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 10,
      "title": "JVM heap used %",
      "description": "Heap used / heap max. Sustained >75% pressures GC; >90% risks circuit breakers.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "expr": "100 * elasticsearch_jvm_memory_used_bytes{cluster=\"semantic-es-temp\",area=\"heap\"} / elasticsearch_jvm_memory_max_bytes{cluster=\"semantic-es-temp\",area=\"heap\"}",
          "legendFormat": "{{name}} heap %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "max": 100,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "id": 11,
      "title": "JVM heap used vs max (bytes)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 6
      },
      "targets": [
        {
          "expr": "elasticsearch_jvm_memory_used_bytes{cluster=\"semantic-es-temp\",area=\"heap\"}",
          "legendFormat": "{{name}} used",
          "refId": "A"
        },
        {
          "expr": "elasticsearch_jvm_memory_max_bytes{cluster=\"semantic-es-temp\",area=\"heap\"}",
          "legendFormat": "{{name}} max",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "id": 12,
      "title": "GC collection rate (collections/s)",
      "description": "rate of elasticsearch_jvm_gc_collection_seconds_count by gc generation.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 6
      },
      "targets": [
        {
          "expr": "rate(elasticsearch_jvm_gc_collection_seconds_count{cluster=\"semantic-es-temp\"}[5m])",
          "legendFormat": "{{gc}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "fillOpacity": 25
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "id": 13,
      "title": "GC time spent (s/s)",
      "description": "rate of elasticsearch_jvm_gc_collection_seconds_sum \u2014 fraction of wall time in GC per generation.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "expr": "rate(elasticsearch_jvm_gc_collection_seconds_sum{cluster=\"semantic-es-temp\"}[5m])",
          "legendFormat": "{{gc}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "fillOpacity": 25
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "id": 14,
      "title": "JVM pools used (young/survivor/old)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "targets": [
        {
          "expr": "elasticsearch_jvm_memory_pool_used_bytes{cluster=\"semantic-es-temp\"}",
          "legendFormat": "{{pool}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "fillOpacity": 25
          }
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "id": 300,
      "title": "OS / host",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 20,
      "title": "OS CPU %",
      "description": "elasticsearch_os_cpu_percent \u2014 node-wide CPU. process_cpu_percent shown for the ES JVM share.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 23
      },
      "targets": [
        {
          "expr": "elasticsearch_os_cpu_percent{cluster=\"semantic-es-temp\"}",
          "legendFormat": "OS {{name}}",
          "refId": "A"
        },
        {
          "expr": "elasticsearch_process_cpu_percent{cluster=\"semantic-es-temp\"}",
          "legendFormat": "ES process {{name}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "max": 100,
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "id": 21,
      "title": "Load average (1m)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 23
      },
      "targets": [
        {
          "expr": "elasticsearch_os_load1{cluster=\"semantic-es-temp\"}",
          "legendFormat": "load1 {{name}}",
          "refId": "A"
        },
        {
          "expr": "elasticsearch_os_load5{cluster=\"semantic-es-temp\"}",
          "legendFormat": "load5 {{name}}",
          "refId": "B"
        },
        {
          "expr": "elasticsearch_os_load15{cluster=\"semantic-es-temp\"}",
          "legendFormat": "load15 {{name}}",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "id": 22,
      "title": "OS memory: used / free / page cache",
      "description": "os.mem.used = ES JVM + everything; the gap between os.mem.used and os.mem.actual_used is the OS page cache (filesystem buffers). Page cache is critical for the bf16 kNN path \u2014 kNN reads vectors off-heap from mmap'd segments, served from page cache when hot.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 23
      },
      "targets": [
        {
          "expr": "elasticsearch_os_mem_used_bytes{cluster=\"semantic-es-temp\"}",
          "legendFormat": "used",
          "refId": "A"
        },
        {
          "expr": "elasticsearch_os_mem_free_bytes{cluster=\"semantic-es-temp\"}",
          "legendFormat": "free",
          "refId": "B"
        },
        {
          "expr": "elasticsearch_os_mem_actual_used_bytes{cluster=\"semantic-es-temp\"}",
          "legendFormat": "actual used (excl. cache)",
          "refId": "C"
        },
        {
          "expr": "elasticsearch_os_mem_used_bytes{cluster=\"semantic-es-temp\"} - elasticsearch_os_mem_actual_used_bytes{cluster=\"semantic-es-temp\"}",
          "legendFormat": "page cache (approx)",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "fillOpacity": 25
          },
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "id": 400,
      "title": "Disk",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 31
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 30,
      "title": "Disk total / used / available (data path)",
      "description": "elasticsearch_filesystem_data_* \u2014 used = size - available.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "expr": "elasticsearch_filesystem_data_size_bytes{cluster=\"semantic-es-temp\"}",
          "legendFormat": "total {{path}}",
          "refId": "A"
        },
        {
          "expr": "elasticsearch_filesystem_data_size_bytes{cluster=\"semantic-es-temp\"} - elasticsearch_filesystem_data_available_bytes{cluster=\"semantic-es-temp\"}",
          "legendFormat": "used {{path}}",
          "refId": "B"
        },
        {
          "expr": "elasticsearch_filesystem_data_available_bytes{cluster=\"semantic-es-temp\"}",
          "legendFormat": "available {{path}}",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "fillOpacity": 25
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^total/"
            },
            "properties": [
              {
                "id": "custom.stacking",
                "value": {
                  "mode": "none",
                  "group": "A"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.drawStyle",
                "value": "line"
              },
              {
                "id": "custom.lineWidth",
                "value": 2
              }
            ]
          }
        ]
      }
    },
    {
      "type": "stat",
      "id": 31,
      "title": "Disk used % + watermark headroom",
      "description": "Disk used %. ES default flood-stage watermark is 95% (index goes read-only). Watch headroom as the bf16 backfill grows the store.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "targets": [
        {
          "expr": "100 * (elasticsearch_filesystem_data_size_bytes{cluster=\"semantic-es-temp\"} - elasticsearch_filesystem_data_available_bytes{cluster=\"semantic-es-temp\"}) / elasticsearch_filesystem_data_size_bytes{cluster=\"semantic-es-temp\"}",
          "legendFormat": "used % {{path}}",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 85
              },
              {
                "color": "orange",
                "value": 90
              },
              {
                "color": "red",
                "value": 95
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "id": 500,
      "title": "Indexing / refresh / flush",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 40
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 40,
      "title": "Indexing rate (docs/s)",
      "description": "rate(elasticsearch_indices_indexing_index_total) \u2014 cluster-wide root-doc indexing throughput from the catch-up indexer.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 41
      },
      "targets": [
        {
          "expr": "rate(elasticsearch_indices_indexing_index_total{cluster=\"semantic-es-temp\"}[5m])",
          "legendFormat": "index docs/s",
          "refId": "A"
        },
        {
          "expr": "rate(elasticsearch_indices_indexing_delete_total{cluster=\"semantic-es-temp\"}[5m])",
          "legendFormat": "delete docs/s",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "id": 41,
      "title": "Index latency (ms/doc)",
      "description": "\u0394 index_time / \u0394 index_total \u2014 average per-doc indexing latency.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 41
      },
      "targets": [
        {
          "expr": "1000 * rate(elasticsearch_indices_indexing_index_time_seconds_total{cluster=\"semantic-es-temp\"}[5m]) / clamp_min(rate(elasticsearch_indices_indexing_index_total{cluster=\"semantic-es-temp\"}[5m]), 1)",
          "legendFormat": "index latency",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "id": 42,
      "title": "Refresh & flush rate + time",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 41
      },
      "targets": [
        {
          "expr": "rate(elasticsearch_indices_refresh_total{cluster=\"semantic-es-temp\"}[5m])",
          "legendFormat": "refresh/s",
          "refId": "A"
        },
        {
          "expr": "rate(elasticsearch_indices_flush_total{cluster=\"semantic-es-temp\"}[5m])",
          "legendFormat": "flush/s",
          "refId": "B"
        },
        {
          "expr": "1000 * rate(elasticsearch_indices_refresh_time_seconds_total{cluster=\"semantic-es-temp\"}[5m]) / clamp_min(rate(elasticsearch_indices_refresh_total{cluster=\"semantic-es-temp\"}[5m]), 1)",
          "legendFormat": "refresh latency (ms)",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "refresh latency (ms)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      }
    },
    {
      "type": "timeseries",
      "id": 43,
      "title": "Indexing throttled?",
      "description": "elasticsearch_indices_indexing_is_throttled (1 = ES is throttling indexing, usually merge backpressure).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 49
      },
      "targets": [
        {
          "expr": "elasticsearch_indices_indexing_is_throttled{cluster=\"semantic-es-temp\"}",
          "legendFormat": "throttled",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "max": 1,
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "id": 600,
      "title": "Search (kNN path)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 57
      },
